# Copy to .env — never commit .env
PORT=8787

# --- Web Search (powers university / VC / hackathon / trading / X ecosystem queries). One of: ---
TAVILY_API_KEY=
SERPER_API_KEY=

# --- Google Maps Places API (New). Without it, OpenStreetMap Overpass is used for map discovery. ---
GOOGLE_MAPS_API_KEY=

# --- Google Sheets (service account). Share the sheet with the service account email as Editor. ---
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# --- Optional: GitHub token raises rate limits (public API works without it) ---
GITHUB_TOKEN=

# --- Optional: Claude for intent parsing (rule-based parser is used otherwise) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Reliability chaos testing: comma-separated source ids to force-fail ---
OH_FORCE_FAIL=
